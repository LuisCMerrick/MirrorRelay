#!/bin/sh
set -e

if ! getent group repogate >/dev/null 2>&1; then
  groupadd --system repogate
fi
if ! getent passwd repogate >/dev/null 2>&1; then
  useradd --system --gid repogate --home-dir /var/lib/repogate --no-create-home --shell /usr/sbin/nologin repogate
fi

install -d -m 0750 -o repogate -g repogate \
  /var/lib/repogate \
  /var/lib/repogate/runtime/upstream-nginx \
  /var/cache/repogate \
  /var/log/repogate \
  /var/log/repogate/upstream-nginx

if [ -f /etc/repogate/config.yaml ]; then
  chown root:repogate /etc/repogate/config.yaml
  chmod 0640 /etc/repogate/config.yaml
fi

if command -v systemctl >/dev/null 2>&1; then
  systemctl daemon-reload || true
  if [ -f /var/lib/repogate/.package-active ]; then
    rm -f /var/lib/repogate/.package-active
    systemctl start repogate.service || true
  fi
fi

exit 0
