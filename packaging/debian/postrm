#!/bin/sh
set -e

if command -v systemctl >/dev/null 2>&1; then
  systemctl daemon-reload || true
fi

case "${1:-}" in
  remove|purge) rm -rf -- /run/mirrorrelay ;;
esac

if [ "${1:-}" = "purge" ]; then
  rm -rf -- \
    /etc/mirrorrelay \
    /var/lib/mirrorrelay \
    /var/cache/mirrorrelay \
    /var/log/mirrorrelay
  userdel mirrorrelay >/dev/null 2>&1 || true
  groupdel mirrorrelay >/dev/null 2>&1 || true
fi

exit 0
