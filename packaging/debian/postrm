#!/bin/sh
set -e

if command -v systemctl >/dev/null 2>&1; then
  systemctl daemon-reload || true
fi

case "${1:-}" in
  remove|purge) rm -rf -- /run/repogate ;;
esac

if [ "${1:-}" = "purge" ]; then
  rm -rf -- \
    /etc/repogate \
    /var/lib/repogate \
    /var/cache/repogate \
    /var/log/repogate
  userdel repogate >/dev/null 2>&1 || true
  groupdel repogate >/dev/null 2>&1 || true
fi

exit 0
