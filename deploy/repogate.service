[Unit]
Description=RepoGate Repository and Registry Reverse Proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=repogate
Group=repogate
ExecStart=/usr/bin/repogate -config /etc/repogate/config.yaml
Restart=on-failure
RestartSec=5s
KillMode=process
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RuntimeDirectory=repogate
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
UMask=0007
ReadWritePaths=/run/repogate /var/lib/repogate /var/cache/repogate /var/log/repogate
EnvironmentFile=-/etc/repogate/environment
LimitNOFILE=1048576
TimeoutStopSec=30min

[Install]
WantedBy=multi-user.target
