[Unit]
Description=MirrorRelay Repository and Registry Reverse Proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mirrorrelay
Group=mirrorrelay
ExecStart=/usr/bin/mirrorrelay -config /etc/mirrorrelay/config.yaml
Restart=on-failure
RestartSec=5s
KillMode=process
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RuntimeDirectory=mirrorrelay
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
UMask=0007
ReadWritePaths=/run/mirrorrelay /var/lib/mirrorrelay /var/cache/mirrorrelay /var/log/mirrorrelay
EnvironmentFile=-/etc/mirrorrelay/environment
LimitNOFILE=1048576
TimeoutStopSec=30min
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=true
LockPersonality=true
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
